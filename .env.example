APP_ENV=dev
LOG_LEVEL=INFO
STORE_PATH=data/store.db
MODEL_PATH=data/model.json
READMISSION_MODEL_PATH=data/readmission_model.json
STORAGE_BACKEND=sqlite
DATABASE_URL=postgresql://medintel:medintel@postgres:5432/medintel
EVENT_BACKEND=sync
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=medintel:clinical-events
REDIS_DEAD_LETTER_STREAM=medintel:clinical-events:dead-letter
REDIS_CONSUMER_GROUP=medintel-workers
REDIS_CONSUMER_NAME=worker-1
REDIS_CLAIM_IDLE_MS=60000
REDIS_MAX_DELIVERY_ATTEMPTS=5
METRICS_ENABLED=true
MODEL_SIGNATURE_REQUIRED=false
MODEL_SIGNATURE_PATH=
MODEL_FALLBACK_ENABLED=false
MODEL_VERSION=baseline-logistic-v1
SCORE_INTERVAL_SECONDS=300
MAX_EVENT_FUTURE_SKEW_MINUTES=15
CORS_ORIGINS=http://localhost:8000
DEMO_AUTH_ENABLED=true
DEMO_CLINICIAN_TOKEN=demo-clinician-token
DEMO_QUALITY_TOKEN=demo-quality-token
DEMO_ADMIN_TOKEN=demo-admin-token
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
OIDC_FACILITY_CLAIM=facility_id

# Optional production integrations
MLFLOW_TRACKING_URI=http://mlflow:5000
